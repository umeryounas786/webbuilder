{
    "version": 2,
    "functions": {
      "api/[...path].js": {
        "runtime": "nodejs18.x"
      }
    },
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "/api/[...path].js"
      }
    ],
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": "/api/[...path]"
      }
    ]
  }
  
  